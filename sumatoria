Algoritmo sumatoria()
  inicio 
  //DECLARACIONES
   definir num, suma Como real

    //cuerpo 
    escribir "ingrese un numero"
      leer num

      suma <- 0
      
     mientras num <> 0 hacer 
      suma <- suma + num 
      leer num
     FinMientras

    escribir "la sumatoria total es:  ", suma
FinAlgoritmo
